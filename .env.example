# Copy to .env and adjust. Never commit .env.
# Every setting is SOCIALMGR_<NAME>; nested settings use __ (see socialmgr/core/config.py).
# Environment variables override this file. Lines starting with # show the default.

# --- Your account -------------------------------------------------------------
SOCIALMGR_ACCOUNT__HANDLE=@your_account
# IANA time zone for local times (socialmgr plan --at, the web app)
SOCIALMGR_ACCOUNT__TZ=Europe/Belgrade
# SOCIALMGR_ACCOUNT__PREMIUM=true

# --- X developer app (OAuth 2.0, Native App, PKCE) ----------------------------
# Client ID only; a Native App has no secret.
SOCIALMGR_X__CLIENT_ID=
# Must match the callback URI set in the X developer portal.
# SOCIALMGR_X__REDIRECT_URI=http://127.0.0.1:8765/auth/x/callback

# --- Data providers -------------------------------------------------------------
# ["x"] collects from your real account (after `socialmgr connect`);
# ["fake_owner"] is the default fake account used for the fixture and tests.
SOCIALMGR_PLUGINS__PROVIDERS=["x"]

# --- Storage ----------------------------------------------------------------------
# Database and probe reports live here (relative to the folder you run socialmgr from).
# SOCIALMGR_DATA_DIR=data
# Backups (default <data dir>/backups). Use an absolute path, e.g. a synced folder:
#   /Users/you/Library/CloudStorage/ProtonDrive-you@proton.me-folder/socialmgr
#   /Users/you/Library/Mobile Documents/com~apple~CloudDocs/socialmgr
# SOCIALMGR_BACKUP_DIR=

# --- Spending -------------------------------------------------------------------
# Collection stops once this month's X API spend reaches the cap (USD).
SOCIALMGR_MONTHLY_CAP_USD=15

# --- Runs -----------------------------------------------------------------------
# Check X's published ranker parameters (param.rs in xai-org/x-algorithm) for changes each run.
# SOCIALMGR_RUN__REGIME_CHECK=true
# Back up at the end of each run, keeping one a day and one a week for this many days / weeks.
# SOCIALMGR_RUN__BACKUP=true
# SOCIALMGR_RUN__BACKUP_KEEP_DAILY=14
# SOCIALMGR_RUN__BACKUP_KEEP_WEEKLY=12

# --- Labelling ------------------------------------------------------------------
# claude_code (default): headless Claude Code on your own login, no API key needed.
# anthropic_api: needs `uv sync --extra api` and an API key below.
# none: rule labels only.
# SOCIALMGR_PLUGINS__LABELER=claude_code
# Only for the anthropic_api labeller.
# SOCIALMGR_ANTHROPIC_API_KEY=

# --- Models (built-in names or module:attribute paths) ---------------------------
# SOCIALMGR_PLUGINS__PRIOR_SOURCE=hand_set
# SOCIALMGR_PLUGINS__CHAMPION_MODEL=nb2
# SOCIALMGR_PLUGINS__CHALLENGER_MODELS=["trailing_median"]

# --- Web server -----------------------------------------------------------------
# The X callback above uses this port; change both together.
# SOCIALMGR_HOST=127.0.0.1
# SOCIALMGR_PORT=8765
