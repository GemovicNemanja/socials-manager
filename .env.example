# Copy to .env and adjust. Never commit .env.
SOCIALMGR_DATA_DIR=data
# SOCIALMGR_BACKUP_DIR=/Volumes/Backup/socialmgr
SOCIALMGR_MONTHLY_CAP_USD=15
SOCIALMGR_ACCOUNT__HANDLE=@your_account
SOCIALMGR_ACCOUNT__TZ=Europe/Belgrade
SOCIALMGR_ACCOUNT__PREMIUM=true
# X developer app (OAuth 2.0, Native App, PKCE): client ID only, no secret
# SOCIALMGR_X__CLIENT_ID=
# Labelling: claude_code (default, uses your Claude Code login) or anthropic_api
# SOCIALMGR_PLUGINS__LABELER=claude_code
# SOCIALMGR_ANTHROPIC_API_KEY=   # only for the anthropic_api labeller
# Plugins (built-in names or module:attribute paths)
# SOCIALMGR_PLUGINS__PROVIDERS='["fake_owner"]'
# SOCIALMGR_PLUGINS__PRIOR_SOURCE=hand_set
# SOCIALMGR_PLUGINS__CHAMPION_MODEL=trailing_median
